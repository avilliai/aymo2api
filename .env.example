# Service
HOST=0.0.0.0
PORT=8019
RELOAD=false
LOG_LEVEL=INFO
API_KEY=

# Account pool
TOKEN_FILE=data/accounts.json
REFRESH_ON_START=true
KEEP_ALIVE_MINUTES=30
REFRESH_CONCURRENCY=5
MAX_PROBE_RETRIES=2
PROBE_RETRY_DELAY=1
UPSTREAM_TIMEOUT=120
TOKEN_WRITE_DEBOUNCE=0.5

# Chat
CHAT_MAX_RETRIES=3
CHAT_RETRY_DELAY=1
CHAT_RETRY_DELAY_MAX=10
AYMO_BASE_URL=https://aymo.ai
AYMO_DEFAULT_MODEL=gpt-5-nano
# Emit upstream reasoning/thinking deltas as assistant content (default off)
AYMO_INCLUDE_REASONING=false
# Ask aymo to run reasoning models in reasoning mode (default off)
AYMO_ENABLE_REASONING=false

# Turnstile (Cloudflare) — local solver on 127.0.0.1:5072, or set YESCAPTCHA_KEY
TURNSTILE_SOLVER_URL=http://127.0.0.1:5072
AYMO_SITEKEY=0x4AAAAAACgaobmeaCdcpmsb
YESCAPTCHA_KEY=

# Proxy used by account requests (per-account proxy and PROXY_LIST take priority)
PROXY=
PROXY_LIST=

# Registration mailbox worker (Cloudflare temp-mail worker)
WORKER_DOMAIN=
EMAIL_DOMAIN=
ADMIN_PASSWORD=
POLL_TIMEOUT=120
POLL_INTERVAL=3

# Registration
THREADS=1
REGISTER_MAX_ATTEMPTS=3
REGISTER_JOB_FILE=data/register-job.json
REGISTER_STOP_CANCEL=true
SLEEP_INTERVAL=5

# Optional account sharing (POST new accounts to another instance)
SHARE_ENABLED=false
SHARE_URL=
SHARE_BEARER_KEY=
