# Service
HOST=0.0.0.0
PORT=8016
RELOAD=false
LOG_LEVEL=INFO
API_KEY=endlesswork

# Account pool
TOKEN_FILE=data/accounts.json
REFRESH_ON_START=false
KEEP_ALIVE_MINUTES=30
REFRESH_CONCURRENCY=5
MAX_PROBE_RETRIES=2
PROBE_RETRY_DELAY=1
UPSTREAM_TIMEOUT=120
TOKEN_WRITE_DEBOUNCE=0.5

# Auto replenishment
AUTO_REPLENISH=true
AUTO_REPLENISH_BATCH=2
MIN_STANDBY_THRESHOLD=2
REPLENISH_COOLDOWN=60

# Chat
CHAT_MAX_RETRIES=3
CHAT_RETRY_DELAY=1
CHAT_RETRY_DELAY_MAX=10
AYMO_BASE_URL=https://aymo.ai
AYMO_DEFAULT_MODEL=gpt-5-nano
AYMO_INCLUDE_REASONING=false
AYMO_ENABLE_REASONING=false

# Turnstile
TURNSTILE_SOLVER_URL= #你部署的turnstile solver服务
AYMO_SITEKEY=0x4AAAAAACgaobmeaCdcpmsb
YESCAPTCHA_KEY=

# Proxy
PROXY=http://127.0.0.1:10809
PROXY_LIST=

# Email Mode: 'outlook' or 'worker'
EMAIL_MODE=outlook

# Outlook Account File & Status
OUTLOOK_ACCOUNT_FILE=outlook_live_20261018_222014.txt
OUTLOOK_STATUS_FILE=data/outlook_usage.json
OUTLOOK_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
OUTLOOK_IMAP_HOSTS=outlook.office365.com;imap-mail.outlook.com
OUTLOOK_IMAP_PORT=993

# Registration mailbox worker (fallback for worker mode)
WORKER_DOMAIN=
EMAIL_DOMAIN=
ADMIN_PASSWORD=
POLL_TIMEOUT=120
POLL_INTERVAL=4

# Registration
THREADS=1
REGISTER_MAX_ATTEMPTS=3
REGISTER_JOB_FILE=data/register-job.json
REGISTER_STOP_CANCEL=true
SLEEP_INTERVAL=5

# Optional account sharing
SHARE_ENABLED=false
SHARE_URL=
SHARE_BEARER_KEY=
